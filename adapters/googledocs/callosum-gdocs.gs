  return "<!DOCTYPE html>\n<html>\n  <head>\n    <base target=\"_top\" />\n    <meta charset=\"utf-8\" />\n    <style>\n      body { font: 13px/1.45 -apple-system, Segoe UI, Roboto, sans-serif; color: #1f2330; margin: 0; padding: 12px; }\n      h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: #6b7180; margin: 16px 0 6px; }\n      h2:first-child { margin-top: 0; }\n      input, select, button { font: inherit; box-sizing: border-box; }\n      input, select { width: 100%; padding: 6px 8px; border: 1px solid #cfd3dc; border-radius: 5px; margin: 3px 0; }\n      button { padding: 6px 10px; border: 1px solid #cfd3dc; border-radius: 5px; background: #fff; cursor: pointer; }\n      button.primary { background: #3b4cca; border-color: #3b4cca; color: #fff; }\n      button:disabled { opacity: .5; cursor: default; }\n      .row { display: flex; gap: 6px; }\n      .row > * { flex: 1; }\n      .muted { color: #6b7180; font-size: 12px; }\n      .result { border: 1px solid #e4e7ee; border-radius: 6px; padding: 7px 8px; margin: 6px 0; }\n      .result .label { display: block; margin-bottom: 5px; }\n      .status { margin-top: 10px; font-size: 12px; min-height: 16px; }\n      .status.err { color: #b23b3b; }\n      .status.ok { color: #2e7d4f; }\n      details { margin-bottom: 4px; }\n      summary { cursor: pointer; color: #3b4cca; font-size: 12px; }\n    </style>\n  </head>\n  <body>\n    <details id=\"settings\">\n      <summary>Connection settings</summary>\n      <input id=\"baseUrl\" placeholder=\"https://callosum-tunnel.clffwrkmn.net\" />\n      <input id=\"token\" type=\"password\" placeholder=\"Access token (Settings \u2192 Remote access)\" />\n      <div class=\"muted\" id=\"tokenState\"></div>\n      <button class=\"primary\" onclick=\"saveSettings()\">Save connection</button>\n    </details>\n\n    <h2>Citation style</h2>\n    <select id=\"style\" onchange=\"onStyleChange()\"></select>\n\n    <h2>Add a citation</h2>\n    <div class=\"row\">\n      <input id=\"q\" placeholder=\"Search your library\u2026\" onkeydown=\"if(event.key==='Enter')doSearch()\" />\n      <button style=\"flex:0 0 auto\" onclick=\"doSearch()\">Search</button>\n    </div>\n    <button onclick=\"doSuggest()\">Suggest from selection</button>\n    <div id=\"results\"></div>\n\n    <h2>Document</h2>\n    <div class=\"row\">\n      <button onclick=\"refresh()\">Refresh</button>\n      <button id=\"flattenBtn\" onclick=\"flatten()\">Flatten\u2026</button>\n    </div>\n\n    <div class=\"status\" id=\"status\"></div>\n\n    <script>\n      function setStatus(msg, kind) {\n        var el = document.getElementById(\"status\");\n        el.textContent = msg || \"\";\n        el.className = \"status\" + (kind ? \" \" + kind : \"\");\n      }\n      function fail(e) { setStatus((e && e.message) || String(e), \"err\"); }\n\n      function loadSettings() {\n        google.script.run.withSuccessHandler(function (s) {\n          document.getElementById(\"baseUrl\").value = s.baseUrl || \"\";\n          document.getElementById(\"tokenState\").textContent = s.hasToken ? \"Token is set.\" : \"No token set yet.\";\n          if (!s.hasToken) document.getElementById(\"settings\").open = true;\n        }).withFailureHandler(fail).getSettings();\n      }\n      function saveSettings() {\n        var url = document.getElementById(\"baseUrl\").value;\n        var tok = document.getElementById(\"token\").value;\n        setStatus(\"Saving\u2026\");\n        google.script.run.withSuccessHandler(function (s) {\n          document.getElementById(\"token\").value = \"\";\n          document.getElementById(\"tokenState\").textContent = s.hasToken ? \"Token is set.\" : \"No token set yet.\";\n          setStatus(\"Connection saved.\", \"ok\");\n          loadStyles();\n        }).withFailureHandler(fail).saveSettings(url, tok);\n      }\n\n      function loadStyles() {\n        google.script.run.withSuccessHandler(function (data) {\n          var sel = document.getElementById(\"style\");\n          sel.innerHTML = \"\";\n          (data.styles || []).forEach(function (st) {\n            var o = document.createElement(\"option\");\n            o.value = st.id; o.textContent = st.title || st.id;\n            if (st.id === data.current) o.selected = true;\n            sel.appendChild(o);\n          });\n        }).withFailureHandler(fail).listStyles();\n      }\n      function onStyleChange() {\n        setStatus(\"Applying style\u2026\");\n        google.script.run.withSuccessHandler(function (r) {\n          setStatus(\"Style applied (\" + r.count + \" citation\" + (r.count === 1 ? \"\" : \"s\") + \").\", \"ok\");\n        }).withFailureHandler(fail).setStyle(document.getElementById(\"style\").value);\n      }\n\n      function doSearch() {\n        var q = document.getElementById(\"q\").value;\n        setStatus(\"Searching\u2026\");\n        google.script.run.withSuccessHandler(renderResults).withFailureHandler(fail).searchPapers(q);\n      }\n      function renderResults(rows) {\n        var box = document.getElementById(\"results\");\n        box.innerHTML = \"\";\n        if (!rows.length) { setStatus(\"No matches.\", null); return; }\n        setStatus(\"\");\n        rows.forEach(function (r) {\n          var div = document.createElement(\"div\");\n          div.className = \"result\";\n          var span = document.createElement(\"span\");\n          span.className = \"label\"; span.textContent = r.label;\n          var btn = document.createElement(\"button\");\n          btn.className = \"primary\"; btn.textContent = \"Insert\";\n          btn.onclick = function () { insert(r.id, btn); };\n          div.appendChild(span); div.appendChild(btn); box.appendChild(div);\n        });\n      }\n      function insert(id, btn) {\n        btn.disabled = true;\n        setStatus(\"Inserting\u2026\");\n        google.script.run.withSuccessHandler(function (r) {\n          btn.disabled = false;\n          setStatus(\"Inserted (\" + r.count + \" citation\" + (r.count === 1 ? \"\" : \"s\") + \" in the document).\", \"ok\");\n        }).withFailureHandler(function (e) { btn.disabled = false; fail(e); }).insertCitation(id);\n      }\n      function doSuggest() {\n        setStatus(\"Finding citations for your selection\u2026\");\n        google.script.run.withSuccessHandler(renderResults).withFailureHandler(fail).suggestFromSelection();\n      }\n      function refresh() {\n        setStatus(\"Refreshing\u2026\");\n        google.script.run.withSuccessHandler(function (r) {\n          setStatus(\"Refreshed \" + r.count + \" citation\" + (r.count === 1 ? \"\" : \"s\") + \".\", \"ok\");\n        }).withFailureHandler(fail).refreshDocument();\n      }\n      var _flattenArmed = false;\n      function flatten() {\n        var btn = document.getElementById(\"flattenBtn\");\n        if (!_flattenArmed) {\n          _flattenArmed = true;\n          btn.textContent = \"Click again to flatten\";\n          setStatus(\"Flatten turns citations into plain text (one-way \u2014 Refresh won't manage them after). Click again to confirm.\");\n          setTimeout(function () { _flattenArmed = false; btn.textContent = \"Flatten\u2026\"; }, 4000);\n          return;\n        }\n        _flattenArmed = false;\n        btn.textContent = \"Flatten\u2026\";\n        setStatus(\"Flattening\u2026\");\n        google.script.run.withSuccessHandler(function (r) {\n          setStatus(\"Flattened \" + r.flattened + \" citation\" + (r.flattened === 1 ? \"\" : \"s\") + \" to plain text.\", \"ok\");\n        }).withFailureHandler(fail).flattenCitations();\n      }\n\n      loadSettings();\n      loadStyles();\n    </script>\n  </body>\n</html>\n";
}
