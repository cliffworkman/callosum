<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
    xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    oor:name="Addons" oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">

    <!-- Top-level "Callosum" menu in Writer. Each item dispatches service:com.callosum.cite.Dispatcher?<action>,
         which instantiates the .oxt dispatcher component and runs the matching action in callosum_cite.py. -->
    <node oor:name="OfficeMenuBar">
      <node oor:name="com.callosum.libreoffice.menu" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Callosum</value></prop>
        <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
        <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
        <node oor:name="Submenu">
          <node oor:name="m00" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?addCitation</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Add citation… (search your library)</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m01" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?suggest</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Suggest citation (from the sentence)</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m02" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?insert</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Insert citation by id…</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <!-- Acting on the EXISTING citation at the cursor (P0 phase 6, backlog #33/#34) — all resolve
               "which citation" via mark_at_cursor (phase 4); each shows an honest message if the cursor isn't
               inside a citation. -->
          <!-- P0 phase 5c: reopens the same live-search composer used for Insert, pre-populated with this
               citation's current items + per-occurrence options. -->
          <node oor:name="m02f" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?editCitation</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Edit citation…</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m02a" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?deleteCitation</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Delete citation</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m02b" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?mergeWithNext</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Merge with next citation</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m02c" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?mergeWithPrevious</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Merge with previous citation</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m02d" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?splitCitation</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Split citation</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m02e" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?openInCallosum</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Open cited work in callosum…</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m02g" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?goToBibliographyEntry</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Go to bibliography entry…</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m03" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop>
          </node>
          <node oor:name="m04" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?refresh</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Refresh / renumber + bibliography</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <!-- P1 item #13: deliberate partial refreshes for large manuscripts. Each still renders the full
               ordered citation set for citeproc correctness, but mutates only the named document surface. -->
          <node oor:name="m04c" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?refreshCitations</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Refresh citations only</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m04s" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?refreshSelectedCitation</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Refresh citation at cursor</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m04t" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?refreshCurrentSection</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Refresh current section</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m04d" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?refreshBibliography</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Refresh bibliography only</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <!-- Automatic-refresh / bibliography controls (P0 phase 7 + P1 item #13) -->
          <node oor:name="m04e" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?toggleCiteAuto</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Toggle automatic citation formatting</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m04a" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?insertBibliographyHere</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Insert bibliography here</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m04k" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?insertSectionBibliography</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Insert current-section bibliography here</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m04l" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?removeSectionBibliography</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Remove bibliography for current section</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m04m" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?manageSectionBibliographies</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Section bibliographies…</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m04h" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?setBibliographyHeading</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Bibliography heading…</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m04n" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?setJournalAbbreviations</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Journal abbreviations…</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m04i" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?toggleBibliographyLinks</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Toggle citation-to-bibliography links</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m04j" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?toggleBibliographyExternalLinks</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Toggle bibliography title/DOI links</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m04b" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?toggleBibAuto</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Toggle automatic bibliography rebuild</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m05" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?setStyle</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Citation style…</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m05a" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?setNotePlacement</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Note placement…</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m05b" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?convertCitationPlacement</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Convert citation placement…</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m06" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?flatten</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Flatten to static text</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <!-- P0 phase 8 (backlog #33/#34): the recommended, safe replacement for a bare Flatten. Always
               saves a separate copy; never mutates the open document. -->
          <node oor:name="m06p" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?prepareSubmissionCopy</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Prepare submission copy…</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m06a" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop>
          </node>
          <!-- Inserts the CRediT contribution statement built + staged in the callosum web UI (Theory → CRediT
               statement → "Send to LibreOffice" → POST /credit/pending). Plain static prose, at the cursor. -->
          <node oor:name="m06b" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?insertStatement</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Insert CRediT statement</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <node oor:name="m07" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop>
          </node>
          <node oor:name="m08" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?setServerUrl</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Server URL…</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <!-- P0 phase 9 (backlog #33/#34, the last of the smaller phases): a read-only health report across
               every recognized citation + the bibliography bookmarks. Never mutates the document. -->
          <node oor:name="m09" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?diagnostics</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Document diagnostics…</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <!-- P1 item #12 (backlog #33/#34): a read-only overview of every unique cited work — occurrence
               count, missing/orphaned + retraction status, click-to-navigate. Never mutates the document. -->
          <node oor:name="m10" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?citationsPanel</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Citations in this document…</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <!-- P2 item #19 (backlog #33/#34, inc 459): a pre-submission retraction re-check for every cited
               paper, folded together with diagnose_document's read-only mechanics report. Never mutates. -->
          <node oor:name="m11" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?citationIntegrityPreflight</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Citation integrity preflight…</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <!-- P2 item #18 (backlog #33/#34, inc 463): citation-concentration signals for this document's own
               cited papers, plus a local scan for long citation-free prose stretches. Never mutates. -->
          <node oor:name="m14" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?citationCoverageAudit</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Citation coverage audit…</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <!-- P2 item #20 (backlog #33/#34, inc 461): Citavi-style insertion of a saved PDF highlight (quote
               and/or your own note) alongside a live citation, with an optional local stance check first. -->
          <node oor:name="m12" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?insertEvidence</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Insert evidence…</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
          <!-- P2 item #21 (backlog #33/#34, inc 462): insert whichever open-science disclosure statement
               (data/code/prereg/funding/COI/ethics/AI use) is currently staged from Work -> Statements. -->
          <node oor:name="m13" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?insertStagedStatement</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Insert statement…</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
          </node>
        </node>
      </node>
    </node>

    <!-- A matching "Callosum" toolbar (text buttons; icons are a later polish). -->
    <node oor:name="OfficeToolBar">
      <node oor:name="com.callosum.libreoffice.toolbar" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Callosum</value></prop>
        <node oor:name="t00" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>service:com.callosum.cite.Dispatcher?addCitation</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">Add citation</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
