<?xml version="1.0" encoding="UTF-8"?>
<!--
  Callosum — Microsoft Word add-in manifest (Office.js, add-in-only XML manifest; inc 164 SP1).
  The task pane + ribbon button are served BY callosum over HTTPS on https://localhost:8443 (Architecture A:
  same-origin with the API, zero egress, desktop Word only). Setup: see adapters/word/README.md.
  The live-field / CSL-JSON cite design follows the Zotero CSL_CITATION pattern (THIRD-PARTY-NOTICES.md);
  office.js is Microsoft's Office platform SDK.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">
  <Id>b7e8c1d2-4f3a-4b5c-9d6e-0a1b2c3d4e5f</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Callosum</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Callosum Citations"/>
  <Description DefaultValue="Cite while you write, backed by your local Callosum library."/>
  <IconUrl DefaultValue="https://localhost:8443/integrations/word/icon.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:8443/integrations/word/icon.png"/>
  <SupportUrl DefaultValue="https://github.com/cliffworkman/callosum"/>
  <AppDomains>
    <AppDomain>https://localhost:8443</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Document"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:8443/integrations/word/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Callosum.Group">
                <Label resid="Callosum.Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16"/>
                  <bt:Image size="32" resid="Icon.32"/>
                  <bt:Image size="80" resid="Icon.80"/>
                </Icon>
                <Control xsi:type="Button" id="Callosum.ShowTaskpane">
                  <Label resid="Callosum.Button.Label"/>
                  <Supertip>
                    <Title resid="Callosum.Button.Label"/>
                    <Description resid="Callosum.Button.Tip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Callosum.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://localhost:8443/integrations/word/icon.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://localhost:8443/integrations/word/icon.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://localhost:8443/integrations/word/icon.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:8443/integrations/word/taskpane.html"/>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://github.com/cliffworkman/callosum"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Callosum Citations"/>
        <bt:String id="Callosum.Group.Label" DefaultValue="Callosum"/>
        <bt:String id="Callosum.Button.Label" DefaultValue="Show Citations"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Search your Callosum library and insert a citation."/>
        <bt:String id="Callosum.Button.Tip" DefaultValue="Search your Callosum library and insert a citation at the cursor."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
