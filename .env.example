# Callosum — example environment file (backlog #20).
#
# Copy this to `.env` (gitignored) and fill in what you need. Nothing here is required to run Callosum —
# every default is local-only, egress-off. `.env` is loaded automatically on startup for local convenience
# (so secrets live in a file, never in a shell history) — see `app/backend/api/startup.py`.

# ── Database ──────────────────────────────────────────────────────────────────────────────────────────
# SQLite database URL. Default: a file under .local/. Persist this (see the README's "Choosing a stable
# database location") and NEVER point it at a cloud-synced folder (Dropbox/OneDrive/iCloud) — a sync client
# holding the .sqlite/-wal files open contends with SQLite's own write lock ("database is locked").
# CALLOSUM_DB_URL=sqlite:///C:/Users/you/callosum-data/library.sqlite

# The watched library folder Callosum scans on launch/focus. Default: library/ under the project root.
# CALLOSUM_LIBRARY_DIR=/path/to/your/pdfs

# ── AI generation (off by default; nothing here is required) ────────────────────────────────────────────
# Consent gate for AI summary/axis-term generation. Unset (or anything but 1/true/yes) = fully local, no
# egress. Only flips on the ONE channel that can leave your machine.
# CALLOSUM_ALLOW_DATA_EGRESS=1

# Provider API keys (only the ones for providers you actually use; can also be set from Settings → AI
# features instead, where they're stored in your OS keychain — never returned over the wire either way).
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Separate opt-in gate for the AI help assistant (sends only your question + the public help docs, never
# your library).
# CALLOSUM_HELP_ASSISTANT_ENABLED=1

# ── Public metadata lookups (NOT the AI gate — Crossref/OpenAlex/PubMed are public, not an LLM) ─────────
# A contact email for the "polite pool" on public metadata APIs. Optional but recommended if you enrich a
# large library — can also be set from Settings → Metadata access.
# CALLOSUM_CROSSREF_MAILTO=you@example.org
# CALLOSUM_OPENALEX_MAILTO=you@example.org

# ── Remote access / accounts (all default-off; only relevant if you expose Callosum beyond localhost) ──
# Recovery hatch: forces Remote access off regardless of the Settings toggle (see the in-app lockout
# recovery for the normal path — this is the environment-level override).
# CALLOSUM_DISABLE_REMOTE_ACCESS=1

# Serves a read-only instance (every mutating HTTP method 403s) — the read-only mobile-companion pattern.
# CALLOSUM_READ_ONLY=1

# Disables the MCP agent-write surface even if otherwise configured/enabled.
# CALLOSUM_DISABLE_AGENT_WRITES=1

# Optional "Sign in with ORCID" (opt-in, identity-only — never sends library text). All five must be set
# together to activate it; see ops/accounts-authentik-setup.md.
# CALLOSUM_OIDC_ISSUER=
# CALLOSUM_OIDC_CLIENT_ID=
# CALLOSUM_OIDC_SCOPES=openid profile
# CALLOSUM_OIDC_CLAIM_ORCID=orcid
# CALLOSUM_OAUTH_REDIRECT=

# Grants the (currently unwired) superuser capability flag to specific ORCIDs, comma-separated.
# CALLOSUM_SUPERUSER_ORCIDS=

# ── Misc ──────────────────────────────────────────────────────────────────────────────────────────────
# Override the served frontend with a single prebuilt HTML file (unset = assemble app/frontend/ live).
# CALLOSUM_FRONTEND_PATH=

# Override where app_settings.json (BYOK keys, egress consent, etc.) is stored. Default: ~/.callosum/.
# CALLOSUM_SETTINGS_PATH=

# Override the Tesseract binary path for OCR fallback, if it's not on PATH.
# CALLOSUM_TESSERACT_PATH=

# Port for `tools/run_https.py` (only needed while citing from desktop Microsoft Word, which requires HTTPS).
# CALLOSUM_HTTPS_PORT=8443
