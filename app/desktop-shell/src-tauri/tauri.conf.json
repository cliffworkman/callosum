{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Callosum",
  "version": "0.1.0",
  "identifier": "com.callosum.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "title": "Callosum",
        "url": "index.html",
        "width": 420,
        "height": 320,
        "resizable": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/python-runtime": "python-runtime",
      "../resources/callosum-src": "callosum-src"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
