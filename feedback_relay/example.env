# Hosted relay only. Never put this value in the desktop environment, frontend, or Tauri configuration.
CALLOSUM_FEEDBACK_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/EXAMPLE/ONLY/REPLACE_ME

# Conservative per-account (verified OIDC) or per-IP (anonymous) limit.
CALLOSUM_FEEDBACK_RATE_LIMIT=5
CALLOSUM_FEEDBACK_RATE_WINDOW_SECONDS=600

# Optional: verify an existing Callosum account token. Anonymous clients remain accepted and IP-limited.
# CALLOSUM_FEEDBACK_OIDC_ISSUER=https://accounts.example.invalid/application/o/callosum/
# CALLOSUM_FEEDBACK_OIDC_AUDIENCE=callosum
# CALLOSUM_FEEDBACK_OIDC_JWKS_URL=https://accounts.example.invalid/application/o/callosum/jwks/

# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
CALLOSUM_FEEDBACK_TRUST_PROXY_HEADERS=0
