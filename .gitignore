.local/
.pytest_cache/
__pycache__/
*.py[cod]
*.sqlite
*.db
*.pdf
# …except the committed QA/test fixture PDF (a tiny real 2-page doc the seed renders; inc 120)
!tests/fixtures/seed.pdf

# --- Secrets (NEVER commit) ---
.env
.env.*
# Any Gemini/Google key file, under any name we've used (GEMINI_API.txt, GEMINI_API_KEYS.md, …) anywhere.
*GEMINI_API*
*.key
.claude/GEMINI_API_KEYS.md
# Snapshot zips (.claude/backups/* etc.) predate the keys→.env move and the OLD ones embed key values
# (inside .claude/GEMINI_API.txt) — exclude every zip anywhere, on top of the .claude/backups/ dir rule.
*.zip

# --- Tool / editor scratch ---
.ruff_cache/
.playwright-mcp/
*.tmp.*

# --- Frontend build toolchain (esbuild; inc 102) — installed via `npm ci` from the committed
# package-lock.json; the binaries are not code we ship. ---
node_modules/

# --- Large local data (not code) ---
library/

# --- Dev-only .claude working space (not for the public repo; the rest of .claude/ IS committed) ---
.claude/backups/
.claude/deprecated/
.claude/plans/
# personal raw to-do scratch (actionable items already folded into the backlog)
.claude/callosum_TDL.txt
# the future-tracks watched inbox is a LOCAL dropzone (Phase 8); it may hold counsel-gated /
# unreviewed prompts (e.g. the deferred legally-ambiguous acquisition lane) — never publish it.
.claude/docs/future-tracks-import/

# transient task-scheduler runtime lock (Claude Code)
.claude/scheduled_tasks.lock
.claude/settings.local.json

# QA mechanism (inc 120): the deposit inbox is a local-only dropzone (reports + screenshots), like .local/;
# the surface map is generated (regenerated by tools/qa/build_surface_map.py extract).
.claude/qa-inbox/
tools/qa/surface-map.json
# the QA bundle drop itself (transient; its files now live in tools/qa/ + .claude/)
qa_routes.zip
